# Telegram Bot API token obtained from @BotFather.
TELOXIDE_TOKEN=

# Only this Telegram user can operate the bot.
TERMPIGEON_OWNER_USER_ID=

# Absolute paths. `codex` and `codex-code-mode-host` must be installed together.
TERMPIGEON_CODEX_BIN=/usr/local/bin/codex
TERMPIGEON_CODEX_HOME=/var/lib/term-pigeon/codex-home
TERMPIGEON_WORKDIR=/srv
TERMPIGEON_STATE_DIR=/var/lib/term-pigeon/state
TERMPIGEON_CODEX_TIMEOUT_SECONDS=1800

# Keep false for workspace-only access. Set true only if the bot is intentionally
# allowed to administer the entire host; Telegram account access then equals root.
TERMPIGEON_DANGEROUSLY_BYPASS_APPROVALS_AND_SANDBOX=false

# Keep teloxide warnings enabled so polling conflicts and network failures are visible.
RUST_LOG=term_pigeon=info,teloxide=warn
